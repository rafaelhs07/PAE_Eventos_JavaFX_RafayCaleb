<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0"
            prefWidth="1050.0"
            style="-fx-background-color: #F8F0E3;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.javafxmenuretos.ArtesaniasController">

    <top>

        <VBox>

            <!-- MENÚ SUPERIOR -->

            <MenuBar style="-fx-background-color: #6B3E26;">

                <menus>

                    <Menu text="Catálogo">

                        <items>

                            <MenuItem text="Ver catálogo"
                                      onAction="#mostrarCatalogo"/>

                            <MenuItem text="Nuevo producto"
                                      onAction="#nuevo"/>

                        </items>

                    </Menu>

                    <Menu text="Ventas">

                        <items>

                            <MenuItem text="Registrar venta"
                                      onAction="#registrarVenta"/>

                        </items>

                    </Menu>

                    <Menu text="Ayuda">

                        <items>

                            <MenuItem text="Cómo usar el sistema"
                                      onAction="#mostrarAyuda"/>

                        </items>

                    </Menu>

                </menus>

            </MenuBar>

            <!-- BARRA DE HERRAMIENTAS -->

            <ToolBar style="-fx-background-color: #D99A4E;">

                <Button text="← Menú"
                        onAction="#volverMenu"
                        style="
                            -fx-background-color: #6B3E26;
                            -fx-text-fill: white;
                            -fx-font-weight: bold;
                        "/>

                <Separator orientation="VERTICAL"/>

                <Button text="Nuevo"
                        onAction="#nuevo"
                        style="
                            -fx-background-color: #6B3E26;
                            -fx-text-fill: white;
                            -fx-font-weight: bold;
                        "/>

                <Button text="Guardar"
                        onAction="#guardar"
                        style="
                            -fx-background-color: #2E7D32;
                            -fx-text-fill: white;
                            -fx-font-weight: bold;
                        "/>

                <Separator orientation="VERTICAL"/>

                <Label text="Buscar: "
                       style="-fx-font-weight: bold;"/>

                <TextField fx:id="txtBuscar"
                           promptText="Nombre o categoría"
                           prefWidth="230"/>

                <Button text="Buscar"
                        onAction="#buscar"
                        style="
                            -fx-background-color: #1E5A7A;
                            -fx-text-fill: white;
                            -fx-font-weight: bold;
                        "/>

            </ToolBar>

        </VBox>

    </top>

    <center>

        <VBox spacing="14">

            <padding>

                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="25"/>

            </padding>

            <Label text="TIENDA DE ARTESANÍAS"
                   style="
                       -fx-font-size: 26px;
                       -fx-font-weight: bold;
                       -fx-text-fill: #6B3E26;
                   "/>

            <Label text="Registro y control de productos artesanales"
                   style="
                       -fx-font-size: 14px;
                       -fx-text-fill: #8A5A3B;
                   "/>

            <!-- FORMULARIO -->

            <GridPane hgap="12"
                      vgap="10"
                      style="
                          -fx-background-color: #FFF9F0;
                          -fx-border-color: #D99A4E;
                          -fx-border-radius: 8;
                          -fx-background-radius: 8;
                          -fx-padding: 16;
                      ">

                <columnConstraints>

                    <ColumnConstraints percentWidth="18"/>
                    <ColumnConstraints percentWidth="32"/>
                    <ColumnConstraints percentWidth="18"/>
                    <ColumnConstraints percentWidth="32"/>

                </columnConstraints>

                <Label text="Nombre:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-font-weight: bold;"/>

                <TextField fx:id="txtNombre"
                           promptText="Ejemplo: Jarrón de barro"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Categoría:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0"
                       style="-fx-font-weight: bold;"/>

                <TextField fx:id="txtCategoria"
                           promptText="Ejemplo: Cerámica"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="0"/>

                <Label text="Precio:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight: bold;"/>

                <TextField fx:id="txtPrecio"
                           promptText="Ejemplo: 18.50"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Stock:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight: bold;"/>

                <TextField fx:id="txtStock"
                           promptText="Ejemplo: 10"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="1"/>

                <Label text="Nombre de imagen:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight: bold;"/>

                <TextField fx:id="txtImagen"
                           promptText="Ejemplo: jarra.png"
                           GridPane.columnIndex="1"
                           GridPane.columnSpan="3"
                           GridPane.rowIndex="2"/>

            </GridPane>

            <!-- CONTADOR -->

            <HBox alignment="CENTER_LEFT"
                  spacing="12">

                <Label text="Productos registrados"
                       style="
                           -fx-font-size: 16px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #6B3E26;
                       "/>

                <Label fx:id="lblCantidad"
                       text="Artesanías registradas: 0"
                       style="
                           -fx-background-color: #E7C58E;
                           -fx-padding: 6 10 6 10;
                           -fx-background-radius: 12;
                           -fx-font-weight: bold;
                           -fx-text-fill: #5A321F;
                       "/>

            </HBox>

            <!-- TABLA -->

            <TableView fx:id="tablaArtesanias"
                       prefHeight="320"
                       VBox.vgrow="ALWAYS"
                       style="
                           -fx-border-color: #B87333;
                           -fx-border-width: 1;
                       ">

                <columns>

                    <TableColumn fx:id="colImagen"
                                 text="Imagen"
                                 prefWidth="105"/>

                    <TableColumn fx:id="colNombre"
                                 text="Nombre"
                                 prefWidth="235"/>

                    <TableColumn fx:id="colCategoria"
                                 text="Categoría"
                                 prefWidth="180"/>

                    <TableColumn fx:id="colPrecio"
                                 text="Precio (C$)"
                                 prefWidth="140"/>

                    <TableColumn fx:id="colStock"
                                 text="Stock"
                                 prefWidth="105"/>

                </columns>

            </TableView>

            <!-- ESTADO -->

            <Label fx:id="lblEstado"
                   text="Sistema listo."
                   wrapText="true"
                   style="
                       -fx-background-color: #F0D8B0;
                       -fx-border-color: #D99A4E;
                       -fx-border-radius: 5;
                       -fx-background-radius: 5;
                       -fx-padding: 10;
                       -fx-text-fill: #5A321F;
                   "/>

        </VBox>

    </center>

</BorderPane>