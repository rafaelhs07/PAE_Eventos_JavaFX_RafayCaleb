<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      prefHeight="650"
      prefWidth="700"
      spacing="12"
      style="-fx-background-color: #3578AB;"
      xmlns="http://javafx.com/javafx/21.0.6"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.javafxmenuretos.InventarioController">

    <padding>
        <Insets bottom="20"
                left="40"
                right="40"
                top="20"/>
    </padding>

    <Label text="INVENTARIO DE PULPERÍA"
           style="
           -fx-font-size: 24px;
           -fx-font-weight: bold;
           -fx-text-fill: #000000;
           "/>

    <Label text="Código"
           maxWidth="Infinity"
           style="-fx-font-weight: bold;"/>

    <TextField fx:id="txtCodigo"
               prefHeight="32"
               promptText="Ingrese el código del producto"/>

    <Label text="Nombre"
           maxWidth="Infinity"
           style="-fx-font-weight: bold;"/>

    <TextField fx:id="txtNombre"
               promptText="Ingrese el nombre del producto"/>

    <Label text="Precio"
           maxWidth="Infinity"
           style="-fx-font-weight: bold;"/>

    <TextField fx:id="txtPrecio"
               promptText="Ingrese el precio"/>

    <Label text="Cantidad"
           maxWidth="Infinity"
           style="-fx-font-weight: bold;"/>

    <TextField fx:id="txtCantidad"
               promptText="Ingrese la cantidad"/>

    <Button text="Guardar producto"
            onAction="#guardarProducto"
            prefWidth="180"
            style="
            -fx-background-color: #FFFFFF;
            -fx-text-fill: #000000;
            -fx-font-weight: bold;
            "/>

    <Label text="Buscar producto por código"
           maxWidth="Infinity"
           style="
           -fx-font-weight: bold;
           -fx-text-fill: #000000;
           "/>

    <TextField fx:id="txtBuscar"
               promptText="Escriba el código y presione ENTER"
               onKeyPressed="#buscarProducto"/>

    <Label text="Productos registrados"
           maxWidth="Infinity"
           style="
           -fx-font-weight: bold;
           -fx-text-fill: #000000;
           "/>

    <TableView fx:id="tablaProductos"
               prefHeight="250"
               prefWidth="600">

        <columns>

            <TableColumn fx:id="columnaCodigo"
                         text="Código"
                         prefWidth="120"/>

            <TableColumn fx:id="columnaNombre"
                         text="Nombre"
                         prefWidth="220"/>

            <TableColumn fx:id="columnaPrecio"
                         text="Precio"
                         prefWidth="120"/>

            <TableColumn fx:id="columnaCantidad"
                         text="Cantidad"
                         prefWidth="120"/>

        </columns>

    </TableView>

</VBox>