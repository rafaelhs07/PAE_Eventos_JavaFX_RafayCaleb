<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="650" prefWidth="700" spacing="12" style="-fx-background-color: #3578AB;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.javafxmenuretos.InventarioController">
    <Button onAction="#volverMenu" prefWidth="150" style="         -fx-background-color: #FFFFFF;         -fx-text-fill: #000000;         -fx-font-weight: bold;         " text="← Volver al menú" />

    <Label style="            -fx-font-size: 24px;            -fx-font-weight: bold;            -fx-text-fill: #000000;            " text="INVENTARIO DE PULPERÍA" />

    <Label maxWidth="Infinity" style="-fx-font-weight: bold;" text="Código" />

    <TextField fx:id="txtCodigo" prefHeight="32" promptText="Ingrese el código del producto" />

    <Label maxWidth="Infinity" style="-fx-font-weight: bold;" text="Nombre" />

    <TextField fx:id="txtNombre" promptText="Ingrese el nombre del producto" />

    <Label maxWidth="Infinity" style="-fx-font-weight: bold;" text="Precio (C$)" />

    <TextField fx:id="txtPrecio" promptText="Ingrese el precio" />

    <Label maxWidth="Infinity" style="-fx-font-weight: bold;" text="Cantidad" />

    <TextField fx:id="txtCantidad" promptText="Ingrese la cantidad" />

    <Button onAction="#guardarProducto" prefWidth="180" style="             -fx-background-color: #FFFFFF;             -fx-text-fill: #000000;             -fx-font-weight: bold;             " text="Guardar producto" />

    <Label maxWidth="Infinity" style="            -fx-font-weight: bold;            -fx-text-fill: #000000;            " text="Buscar producto por código" />

    <TextField fx:id="txtBuscar" onKeyPressed="#buscarProducto" promptText="Escriba el código y presione ENTER" />

    <Label maxWidth="Infinity" style="            -fx-font-weight: bold;            -fx-text-fill: #000000;            " text="Productos registrados" />

    <TableView fx:id="tablaProductos" prefHeight="250" prefWidth="600">

        <columns>

            <TableColumn fx:id="columnaCodigo" prefWidth="120" text="Código" />

            <TableColumn fx:id="columnaNombre" prefWidth="220" text="Nombre" />

            <TableColumn fx:id="columnaPrecio" prefWidth="120" text="Precio" />

            <TableColumn fx:id="columnaCantidad" prefWidth="120" text="Cantidad" />

        </columns>

    </TableView>
    <padding>
        <Insets bottom="20" left="40" right="40" top="20" />
    </padding>

</VBox>
