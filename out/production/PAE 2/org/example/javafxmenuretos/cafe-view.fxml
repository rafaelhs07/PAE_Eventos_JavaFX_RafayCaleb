<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      spacing="12"
      prefWidth="760"
      prefHeight="680"
      style="-fx-background-color: #E5D8C8;"
      xmlns="http://javafx.com/javafx/21.0.6"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.javafxmenuretos.CafeController">

    <padding>
        <Insets top="20"
                right="40"
                bottom="20"
                left="40"/>
    </padding>

    <Label text="RECEPCIÓN DE CAFÉ"
           style="
           -fx-font-size: 24px;
           -fx-font-weight: bold;
           -fx-text-fill: #159B9B;
           "/>

    <Label text="Código del lote"
           maxWidth="Infinity"
           style="-fx-font-weight: bold;"/>

    <TextField fx:id="txtCodigo"
               promptText="Ejemplo: L001"/>

    <Label text="Productor"
           maxWidth="Infinity"
           style="-fx-font-weight: bold;"/>

    <TextField fx:id="txtProductor"
               promptText="Nombre del productor"/>

    <Label text="Municipio"
           maxWidth="Infinity"
           style="-fx-font-weight: bold;"/>

    <TextField fx:id="txtMunicipio"
               promptText="Ejemplo: Jinotega"/>

    <Label text="Peso en kg"
           maxWidth="Infinity"
           style="-fx-font-weight: bold;"/>

    <TextField fx:id="txtPeso"
               promptText="Ejemplo: 120"/>

    <Label text="Calidad"
           maxWidth="Infinity"
           style="-fx-font-weight: bold;"/>

    <ComboBox fx:id="comboCalidad"
              promptText="Seleccione la calidad"
              prefWidth="250"/>

    <Button text="Guardar lote"
            onAction="#guarderLote"
            prefWidth="180"
            style="
            -fx-background-color: #159B9B;
            -fx-text-fill: white;
            -fx-font-weight: bold;
            "/>

    <Label text="Lotes registrados"
           maxWidth="Infinity"
           style="
           -fx-font-weight: bold;
           -fx-text-fill: #159B9B;
           "/>

    <TableView fx:id="tablaLotes"
               prefHeight="270"
               onMouseClicked="#mostrarDetalles">

        <columns>

            <TableColumn fx:id="colCodigo"
                         text="Código"
                         prefWidth="100"/>

            <TableColumn fx:id="colProductor"
                         text="Productor"
                         prefWidth="180"/>

            <TableColumn fx:id="colMunicipio"
                         text="Municipio"
                         prefWidth="150"/>

            <TableColumn fx:id="colPeso"
                         text="Peso kg"
                         prefWidth="120"/>

            <TableColumn fx:id="colCalidad"
                         text="Calidad"
                         prefWidth="120"/>

        </columns>

    </TableView>

</VBox>